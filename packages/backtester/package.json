{
  "name": "@solana-symphony/backtester",
  "version": "0.0.0",
  "private": true,
  "description": "Backtest engine + CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "backtester": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "node dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@solana-symphony/data": "workspace:*",
    "@solana-symphony/dsl": "workspace:*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  }
}
