  "version": 1,
  "rebalance": "weekly",
  "root": {
    "type": "filter",
    "sortBy": { "type": "indicator", "name": "cumulativeReturn", "symbol": "", "window": 30 },
    "order": "top",
    "select": 2,
    "children": [
      { "type": "asset", "symbol": "SOL" },
      { "type": "asset", "symbol": "JUP" },
      { "type": "asset", "symbol": "JTO" },
      { "type": "asset", "symbol": "BONK" },
      { "type": "asset", "symbol": "WIF" }
    ]
  }
}
