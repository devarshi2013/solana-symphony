# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Never commit real keys or keypairs.
# All variables are required; @solana-symphony/config throws naming any that are missing.

# --- Solana ---
# RPC endpoint. Public devnet is rate-limited; use a dedicated provider for real work.
SOLANA_RPC_URL=https://api.devnet.solana.com
# One of: devnet, testnet, mainnet-beta, localnet
SOLANA_CLUSTER=devnet

# --- Keeper ---
# Absolute path to the keeper's keypair JSON (keep it outside the repo; ~ is not expanded).
KEEPER_KEYPAIR_PATH=/absolute/path/to/keeper-devnet-keypair.json

# --- Historical price data ---
# Provider name used by packages/data, e.g. birdeye, coingecko
PRICE_API_PROVIDER=your-price-provider
PRICE_API_KEY=your-price-api-key

# --- Anthropic ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/solana_symphony

# --- Alerts ---
# Webhook the keeper posts alerts to (e.g. Slack or Discord incoming webhook)
ALERT_WEBHOOK_URL=https://hooks.example.com/your-webhook
