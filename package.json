{
  "name": "solana-symphony",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:program": "anchor build --arch v0",
    "build:program:devnet-mock": "scripts/build-devnet-mock.sh",
    "test:program": "scripts/build-devnet-mock.sh && cargo test -p vault -p mock-swap --lib && cd tests/vault-litesvm && cargo test",
    "test:program:ts": "scripts/test-program-ts.sh",
    "deploy:devnet": "scripts/build-devnet-mock.sh && node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/deploy-devnet.ts",
    "test:jupiter-fork": "anchor build --arch v0 && JUPITER_FORK=1 pnpm --filter @solana-symphony/vault exec vitest run tests/jupiter-fork.test.ts",
    "data:fetch": "pnpm --filter @solana-symphony/data... run build && node packages/data/dist/fetch-history.js",
    "data:check": "pnpm --filter @solana-symphony/data... run build && node packages/data/dist/data-check.js",
    "data:import": "pnpm --filter @solana-symphony/data... run build && node packages/data/dist/data-import.js",
    "backtest": "pnpm --filter @solana-symphony/backtester... run build && node packages/backtester/dist/cli.js",
    "backtest:serve": "pnpm --filter @solana-symphony/backtester... run build && node packages/backtester/dist/serve.js",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@eslint/js": "^10.0.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
